<%@ page import="java.util.*,com.banking.util.Input" %>
<% Map<String,Object> ticketItem=(Map<String,Object>)request.getAttribute("ticketRecord");String ticketState=String.valueOf(ticketItem.get("status")); %>
<% if("OPEN".equals(ticketState) && ticketItem.get("assigned_employee_id")==null){ %><form method="post"><input type="hidden" name="csrf" value="<%= session.getAttribute("csrf") %>"><input type="hidden" name="id" value="<%= ticketItem.get("ticket_id") %>"><input type="hidden" name="action" value="ticket-update"><label>Subject<input name="subject" maxlength="150" value="<%= Input.html(ticketItem.get("subject")) %>" required></label><label>Description<textarea name="description" maxlength="5000" required><%= Input.html(ticketItem.get("description")) %></textarea></label><button>Update unassigned ticket</button></form><% } %>
<% if(!"CLOSED".equals(ticketState)){ %><form method="post"><input type="hidden" name="csrf" value="<%= session.getAttribute("csrf") %>"><input type="hidden" name="id" value="<%= ticketItem.get("ticket_id") %>"><input type="hidden" name="action" value="ticket-close"><p>Closing keeps this ticket and its response in your history.</p><button>Close ticket</button></form><% } %>
