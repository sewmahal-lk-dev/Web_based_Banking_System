  "src\\main\\webapp\\register.jsp": [
    "<form action=\"<%= request.getContextPath() %",
    "<input id=\"name\" type=\"text\" name=\"name\" placeholder=\"Enter your full name\"\n                                            autocomplete=\"name\" required",
    "<input id=\"email\" type=\"email\" name=\"email\" placeholder=\"name@example.com\"\n                                            autocomplete=\"email\" required",
    "<input id=\"phone\" type=\"tel\" name=\"phone\" placeholder=\"+94 77 123 4567\"\n                                            autocomplete=\"tel\" required",
    "<input id=\"dateOfBirth\" type=\"date\" name=\"dateOfBirth\"",
    "<select id=\"accountType\" name=\"accountType\" required",
    "<input id=\"address\" type=\"text\" name=\"address\"\n                                            placeholder=\"Enter your residential address\" autocomplete=\"street-address\"",
    "<input id=\"city\" type=\"text\" name=\"city\" placeholder=\"Colombo\"\n                                            autocomplete=\"address-level2\"",
    "<input id=\"postalCode\" type=\"text\" name=\"postalCode\" placeholder=\"00100\"\n                                            autocomplete=\"postal-code\"",
    "<input id=\"password\" type=\"password\" name=\"password\"\n                                                placeholder=\"Minimum 8 characters\" minlength=\"8\"\n                                                autocomplete=\"new-password\" required",
    "<button type=\"button\" class=\"show-password\"\n                                                onclick=\"togglePassword('password', this)\"",
    "<input id=\"confirmPassword\" type=\"password\" name=\"confirmPassword\"\n                                                placeholder=\"Repeat your password\" minlength=\"8\"\n                                                autocomplete=\"new-password\" required",
    "<button type=\"button\" class=\"show-password\"\n                                                onclick=\"togglePassword('confirmPassword', this)\"",
    "<input type=\"checkbox\" id=\"terms\" required",
    "<button type=\"submit\" class=\"create-btn\""
