<%@ page contentType="text/html;charset=UTF-8" import="java.util.*,com.banking.util.Input" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Notifications | LankaTrust Bank</title>
<link rel="stylesheet" href="<%= request.getContextPath() %>/assets/css/notifications.css"><script defer src="<%= request.getContextPath() %>/assets/js/notifications.js"></script><script src="<%= request.getContextPath() %>/assets/js/theme-init.js"></script><link rel="stylesheet" href="<%= request.getContextPath() %>/assets/css/banking-system.css"><link rel="stylesheet" href="<%= request.getContextPath() %>/assets/css/design-system.css"><script defer src="<%= request.getContextPath() %>/assets/js/banking-ui.js"></script><link rel="stylesheet" href="<%= request.getContextPath() %>/assets/css/workspaces.css">
<script defer src="<%= request.getContextPath() %>/assets/js/workspaces.js"></script>
</head>
<body class="notifications-page"><header class="topbar"><div class="notification-identity"><strong>LankaTrust</strong><span><%= Input.html(session.getAttribute("userName")) %> &middot; <%= Input.html(String.valueOf(session.getAttribute("role")).replace('_',' ')) %></span></div><a href="<%= request.getContextPath() %><%= "CUSTOMER".equals(session.getAttribute("role"))?"/customer/dashboard":"/employee/dashboard" %>">Back to dashboard</a><a href="<%= request.getContextPath() %>/logout">Sign out</a><jsp:include page="/WEB-INF/fragments/notification-bell.jsp" /></header>
<main id="main"><p class="eyebrow">LANKATRUST / YOUR UPDATES</p><h1>Notifications</h1><% request.setAttribute("notificationDisplayItems",request.getAttribute("notificationPage")); %><jsp:include page="/WEB-INF/fragments/notification-items.jsp" />
<nav aria-label="Notification pages"><% int notificationPage=(Integer)request.getAttribute("pageNumber");if(notificationPage>1){ %><a href="?page=<%= notificationPage-1 %>">Previous</a><% } %> Page <%= notificationPage %> <% if(((List<?>)request.getAttribute("notificationPage")).size()==25){ %><a href="?page=<%= notificationPage+1 %>">Next</a><% } %></nav></main></body></html>
