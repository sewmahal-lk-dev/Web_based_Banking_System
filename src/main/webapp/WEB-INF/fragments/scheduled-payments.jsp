<%@ page import="java.util.*,com.banking.util.Input" %>
<section class="panel services-content"><h2>Scheduled bill payments</h2><p>Schedule without reserving funds. When due, use Pay due bill to process it once. This demo does not run background payments.</p>
<% if(request.getAttribute("scheduleError")!=null){ %><p role="alert">Scheduled payments could not be loaded. Please try again.</p><% } %>
<form method="post" action="<%= request.getContextPath() %>/customer/payment-plans"><input type="hidden" name="csrf" value="<%= session.getAttribute("csrf") %>"><input type="hidden" name="action" value="schedule">
<label>Provider<input name="recipient" maxlength="150" required></label><label>Bill / Consumer Account Number<input name="billReference" maxlength="100" placeholder="Enter consumer or bill account number" required></label><label>Amount (LKR)<input type="number" name="amount" min="0.01" step="0.01" required></label><label>Due date/time (Sri Lanka)<input type="datetime-local" name="date" required></label><button>Schedule payment</button></form>
<% List<Map<String,Object>> plans=(List<Map<String,Object>>)request.getAttribute("scheduledPayments");if(plans!=null && plans.isEmpty()){ %><p>No scheduled payments yet.</p><% } if(plans!=null)for(var plan:plans){ %><article class="record"><h3><%= Input.html(plan.get("recipient")) %></h3><% if(plan.get("bill_reference")!=null){ %><p>Consumer / Bill No: <%= Input.html(plan.get("bill_reference")) %></p><% } %><p>LKR <%= Input.html(plan.get("amount")) %> | <%= Input.html(plan.get("scheduled_date")) %> | <%= Input.html(plan.get("status")) %></p><p><%= Input.html(plan.get("reference_number")) %></p>
<% if("PENDING".equals(plan.get("status"))){ %><form method="post" action="<%= request.getContextPath() %>/customer/payment-plans"><input type="hidden" name="csrf" value="<%= session.getAttribute("csrf") %>"><input type="hidden" name="id" value="<%= plan.get("payment_id") %>"><input type="hidden" name="action" value="update"><label>Provider<input name="recipient" maxlength="150" value="<%= Input.html(plan.get("recipient")) %>" required></label><label>Bill / Consumer Account Number<input name="billReference" maxlength="100" value="<%= Input.html(plan.get("bill_reference")) %>" required></label><label>Amount<input type="number" name="amount" min="0.01" step="0.01" value="<%= Input.html(plan.get("amount")) %>" required></label><label>Reschedule<input type="datetime-local" name="date" required></label><button>Update scheduled payment</button></form>
<% for(String act:List.of("cancel","execute")){ %><form method="post" action="<%= request.getContextPath() %>/customer/payment-plans"><input type="hidden" name="csrf" value="<%= session.getAttribute("csrf") %>"><input type="hidden" name="id" value="<%= plan.get("payment_id") %>"><input type="hidden" name="action" value="<%= act %>"><button><%= "cancel".equals(act)?"Cancel scheduled payment":"Pay due bill" %></button></form><% } } %></article><% } %></section>
